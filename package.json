{
  "name": "trace",
  "version": "0.1.0",
  "private": true,
  "description": "Free step-by-step simulators that show how computers make decisions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node dev.mjs",
    "test": "node tests/run.mjs",
    "e2e": "node build.mjs && npm --prefix e2e test",
    "shots": "node build.mjs && npm --prefix e2e run shots",
    "build:ci": "node tests/run.mjs && node build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
